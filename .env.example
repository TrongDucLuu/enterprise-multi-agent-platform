# ==========================================
# IT Helpdesk Multi-Agent AI - Environment Variables
# ==========================================

# Môi trường chạy (development | staging | production)
ENVIRONMENT=development

# Google Cloud Project & Vị trí
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# Enterprise SSO / Google OIDC Configuration
# Client ID được cấp từ Google Cloud Console (OAuth 2.0 Client IDs)
SSO_CLIENT_ID=your-oauth2-client-id.apps.googleusercontent.com
SSO_ISSUER=https://accounts.google.com

# Danh sách domain công ty được phép đăng nhập (phân cách bằng dấu phẩy)
# BẮT BUỘC phải thiết lập khi chạy trên Production (Fail-Closed)
ALLOWED_DOMAINS=company.com,subsidiary.com

# Cờ bật chế độ Mock Token cho Local Dev (Mặc định: false. Luôn bị cưỡng chế = false trong Production)
ALLOW_LOCAL_DEV_SSO=false

# Secret Key chỉ dùng cho Dev Mock Token (HS256)
SSO_JWT_SECRET=dev-secret-key-change-in-local-only

# Cơ sở dữ liệu & Lưu trữ (Persistence)
# Bật Firestore cho hệ thống lưu trữ tickets (tự động bật trên Cloud Run)
USE_FIRESTORE_TICKETS=false
AI_ASSETS_BUCKET=your-gcp-ai-assets-bucket

# Enterprise RAG Knowledge Base Backend ('in_memory' | 'bigquery')
KNOWLEDGE_BACKEND=in_memory
BIGQUERY_KB_DATASET=it_helpdesk_kb

# Semantic Cache Layer (Tối ưu hóa chi phí token và độ trễ phản hồi < 50ms)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400

# Vertex AI Memory Bank (Trí nhớ dài hạn)
AGENT_ENGINE_MEMORY_BANK_NAME=it_helpdesk_agent

# Giám sát & Tracing (OpenTelemetry -> Google Cloud Trace)
OTEL_TO_CLOUD=false
